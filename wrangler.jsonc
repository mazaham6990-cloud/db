{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "db",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "dfa25b4d-33b0-4940-bfb3-6f99fdc2bcd2","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "e6577b5230dd41d8bdec13366a1fe397" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
